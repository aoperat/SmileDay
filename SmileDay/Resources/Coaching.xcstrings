    "smileCue.cared-for" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "needs_review", "value" : "What face would you want someone who loves you to see?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "나를 아끼는 사람에게 어떤 표정을 보여주고 싶나요?" } }
